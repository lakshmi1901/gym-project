DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=gym_project
# Set DB_SSL=true for hosted MySQL; optionally provide the provider's CA certificate.
DB_SSL=false
# DB_SSL_CA=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----
PORT=3000
# Required in production: use a random secret of at least 32 characters.
# JWT_SECRET=use-a-random-secret-of-at-least-32-characters
# JWT_EXPIRES_IN=2h
# DEFAULT_ADMIN_EMAIL=beastgym@gmail.com
# DEFAULT_ADMIN_PASSWORD=choose-your-password

# Frontend build-time variable: public API URL
# VITE_API_URL=https://your-api.example.com
# Backend: exact allowed frontend origin(s), comma-separated
# CORS_ORIGINS=https://your-site.netlify.app
